# Copiá este archivo como .env.local y completalo. .env.local no se sube al repo.

# Panel del local: generá estas dos líneas con
#   node scripts/hash-password.mjs "la-contraseña-del-panel"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Verificación antibots en el ingreso al panel (Cloudflare Turnstile, gratis). Opcional.
# Sin estas claves, el ingreso igual tiene límite de intentos y campo trampa.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dirección pública de la tienda (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://amancay.com.ar

# Medición (solo se usa si la persona acepta la medición en el aviso de cookies). Opcional.
NEXT_PUBLIC_GA_ID=

# Base de datos (Supabase). La clave secreta va solo en el servidor: nunca con NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Mercado Pago. MP_WEBHOOK_SECRET sale de Tus integraciones > Webhooks.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
